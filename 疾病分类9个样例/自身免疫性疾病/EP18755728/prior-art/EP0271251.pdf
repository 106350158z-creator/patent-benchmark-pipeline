               <rdf:li>G02F 01/37</rdf:li>
               <rdf:li>C07C127/19</rdf:li>
               <rdf:li>C07C125/063</rdf:li>
               <rdf:li>Second harmonic generation by carbamic acid derivatives</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Second harmonic generation by carbamic acid derivatives - European Patent Office - EP 0271251 A1</rdf:li>
               <rdf:li xml:lang="en">Second harmonic generation by carbamic acid derivatives - European Patent Office - EP 0271251 A1</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
