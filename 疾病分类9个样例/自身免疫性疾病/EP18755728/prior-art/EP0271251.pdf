      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>EP-0271251-A1-19880615</dc:identifier>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This invention is concerned with materials for nonlinear optical devices for the conversion of optical energy at one frequency to optical energy at another frequency.This invention provides devices for and method of generating coherent second harmonic light radiation. The devices comprise a laser source (10) of coherent light radiation at a fixed fundamental frequency, a crystalline chiral N-aryl carbamyl compound (12) that crystallizes in a non-centrosymmetric configuration, means (14) for directing the output radiation of the laser onto the crystalline chiral N-aryl carbamyl compound (12), and output means (16, 18, 20, 22) for utilizing the second harmonic frequency.</rdf:li>
               <rdf:li xml:lang="en">This invention is concerned with materials for nonlinear optical devices for the conversion of optical energy at one frequency to optical energy at another frequency.This invention provides devices for and method of generating coherent second harmonic light radiation. The devices comprise a laser source (10) of coherent light radiation at a fixed fundamental frequency, a crystalline chiral N-aryl carbamyl compound (12) that crystallizes in a non-centrosymmetric configuration, means (14) for directing the output radiation of the laser onto the crystalline chiral N-aryl carbamyl compound (12), and output means (16, 18, 20, 22) for utilizing the second harmonic frequency.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:language>
            <rdf:Bag>
               <rdf:li>en</rdf:li>
            </rdf:Bag>
         </dc:language>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>European Patent Office</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>EP0271251</rdf:li>
